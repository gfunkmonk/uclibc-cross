CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="/opt/x-tools/alpha-unknown-linux-uclibc"
CT_TARGET_ALIAS="alpha-unknown-linux-uclibc"
# CT_LOG_PROGRESS_BAR is not set
CT_ARCH_ALPHA_EV67=y
CT_ARCH_ALPHA_VARIANT="ev67"
CT_ARCH_64=y
CT_KERNEL_LINUX=y
CT_LINUX_V_6_18=y
CT_LIBC_UCLIBC_NG=y
CT_UCLIBC_NG_V_1_0_59=y
CT_BINUTILS_PLUGINS=y
CT_CC_LANG_CXX=y
CT_THREADS_LT=y
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--disable-shared --disable-fixed-point"
CT_LINKER_MOLD=y
CT_GCC_V_16=y
CT_BINUTILS_V_2_47=y
# Ensure these are set in your target configs
CT_GCC_LTO=n
CT_LIBC_UCLIBC_DEBUG_LEVEL_0=y
CT_LIBC_UCLIBC_HAS_BACKTRACE=n
# CT_SHOW_CT_VERSION is not set yet
