#!/bin/bash

set -e
set -o pipefail

if [[ $# -lt 1 || -z "$1" ]]; then
    echo "Usage: $0 <target>" >&2
    echo "Example: $0 x86_64-unknown-linux-uclibc" >&2
    exit 1
fi

TARGET=$1
if [[ ! -d "targets/${TARGET}" ]]; then
    echo "Error: target '${TARGET}' not found in targets/" >&2
    exit 1
fi

# packages
sudo apt-get update -qy
sudo apt-get install -y --no-install-recommends \
  automake bison bzip2 ca-certificates cmake \
  curl file flex g++ gawk gdb git gperf help2man \
  libncurses-dev libssl-dev libtool-bin make patch \
  pkg-config python3 rsync texinfo unzip wget xz-utils \
  libzstd-dev

# Add newline to patches without one
find targets/ -name "*.patch" | while read -r f; do
    if [[ $(tail -c1 "$f" | wc -l) -eq 0 ]]; then
        echo "" >> "$f"
        echo "Fixed: $f"
    fi
done
# patch
pushd builder
git reset --hard HEAD
git clean -fd
shopt -s nullglob
UCLIBC_VER=$(grep -oP '^CT_LIBC_UCLIBC_NG_VERSION="\K[^"]+' "../targets/${TARGET}/config" 2>/dev/null || echo "1.0.58")
for i in ../targets/"${TARGET}"/*.patch; do
    if grep -qE "^\+\+\+ b/packages/" "$i"; then
        # Wrapped package patch — apply it to create the patch file in place
        patch -Np1 -i "$i"
    elif grep -qE "^\+\+\+ b/(libc|ldso|extra)/" "$i"; then
        # Raw/unwrapped package patch — copy directly for ct-ng to consume
	mkdir -p "packages/uClibc-ng/${UCLIBC_VER}"
	cp "$i" "packages/uClibc-ng/${UCLIBC_VER}/$(basename "$i")"
    else
        # ct-ng core patch (scripts/build/arch etc.)
        patch -Np1 -i "$i"
    fi
done
shopt -u nullglob
popd

# crosstool-ng
sudo mkdir -p /opt
sudo chmod 0777 /opt
sudo rm -rf /opt/ct-ng
pushd builder
./bootstrap
./configure --prefix=/opt/ct-ng
make -j"$(nproc)"
sudo make install
popd

EXTRA_CT_NG_ARGS=""
case "${TARGET}" in
    alpha-unknown-linux-uclibc)
        export TARGET_CFLAGS="-mcpu=ev67 -mieee -fno-use-linker-plugin"
        export TARGET_LDFLAGS="-Wl,--no-check-sections -Wl,--no-check-sections -Wl,--defsym=__preinit_array_start=0 -Wl,--defsym=__preinit_array_end=0 -Wl,--defsym=__init_array_start=0 -Wl,--defsym=__init_array_end=0 -Wl,--defsym=__fini_array_start=0 -Wl,--defsym=__fini_array_end=0 -fno-use-linker-plugin""
        ;;
    loongarch64-unknown-linux-uclibc)
        export TARGET_CFLAGS="-march=loongarch64 -mabi=lp64d -mtune=la464"
        ;;
    powerpc-unknown-linux-uclibc | powerpcle-unknown-linux-uclibc)
        export TARGET_CFLAGS="-msecure-plt"
        ;;
    powerpc64-unknown-linux-uclibc)
        export TARGET_CFLAGS="-mpowerpc64 -m64 -mminimal-toc"
        ;;
    powerpc64le-unknown-linux-uclibc)
        export TARGET_CFLAGS="-mpowerpc64 -m64 -mabi=elfv2 -mminimal-toc"
        ;;
    riscv32-unknown-linux-uclibc)
        export TARGET_CFLAGS="-march=rv32g -mabi=ilp32d"
        ;;
    riscv64-unknown-linux-uclibc)
        export TARGET_CFLAGS="-march=rv64gc -mabi=lp64d"
        ;;
    sparc-unknown-linux-uclibc)
        export TARGET_CFLAGS="-mcpu=v9"
        ;;
    sparc64-unknown-linux-uclibc)
        export TARGET_ASFLAGS="-m64"
        export TARGET_CFLAGS="-mcpu=ultrasparc3 -m64 -mno-app-regs -Wno-pointer-to-int-cast"
        ;;
    s390-ibm-linux-uclibc)
        export TARGET_CFLAGS="-march=z9-109 -mtune=z10 -m31"
        export TARGET_LDFLAGS="-m31"
        ;;
    s390x-ibm-linux-uclibc)
        export TARGET_CFLAGS="-march=z196 -mtune=zEC12 -m64"
        export TARGET_LDFLAGS="-m64"
        ;;
    *)
        echo "Using default config settings for ${TARGET}"
        ;;
esac


export CROSS_COMPILE="${TARGET}-"
# build
rm -rf build
mkdir -p build
cp targets/"${TARGET}"/config build/.config
if [[ -f "targets/${TARGET}/uClibc-ng.config" ]]; then
    cp "targets/${TARGET}/uClibc-ng.config" build/uClibc-ng.config
    echo "CT_LIBC_UCLIBC_CONFIG_FILE=\"$(pwd)/build/uClibc-ng.config\"" >> build/.config
    echo "Copied uClibc-ng.config for ${TARGET}"
fi

# Configure tarballs directory for download caching
if [[  ! -d "/mnt/tarballs" ]]; then
  sudo mkdir -p /mnt/tarballs 
  sudo chmod 0777 /mnt/tarballs
fi
echo 'CT_LOCAL_TARBALLS_DIR="/mnt/tarballs"' >> build/.config
echo 'CT_SAVE_TARBALLS=y' >> build/.config

if [[ -n "${TARGET_ASFLAGS}" ]]; then
    sed -i '/^CT_TARGET_ASFLAGS=/d' build/.config
    echo "CT_TARGET_ASFLAGS=\"${TARGET_ASFLAGS}\"" >> build/.config
fi
if [[ -n "${TARGET_CFLAGS}" ]]; then
    sed -i '/^CT_TARGET_CFLAGS=/d' build/.config
    echo "CT_TARGET_CFLAGS=\"${TARGET_CFLAGS}\"" >> build/.config
fi
if [[ -n "${TARGET_LDFLAGS}" ]]; then
    sed -i '/^CT_TARGET_LDFLAGS=/d' build/.config
    echo "CT_TARGET_LDFLAGS=\"${TARGET_LDFLAGS}\"" >> build/.config
fi

pushd build
/opt/ct-ng/bin/ct-ng olddefconfig
/opt/ct-ng/bin/ct-ng build."$(nproc)" ${EXTRA_CT_NG_ARGS}
popd

# tarball
sudo mv /opt/x-tools/"${TARGET}" .
sudo chown -R root:root "${TARGET}"
env XZ_OPT="-T0" sudo tar -cJvf "${TARGET}".tar.xz "${TARGET}"
sudo sha256sum "${TARGET}".tar.xz | awk '{ print $1 }' > "${TARGET}".tar.xz.sha256
